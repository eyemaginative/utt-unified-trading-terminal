# UTT backend env example
#
# Copy this file to a private location outside the repository, for example:
#   C:\path\to\utt-secrets\backend.env
#
# Then point backend/.env at it with:
#   UTT_ENV_PATH=C:\path\to\utt-secrets\backend.env
#
# Do not commit real API keys, seed phrases, wallet addresses, private key paths,
# database files, or machine-specific private paths. Venue API/RPC keys should be
# saved through Profile -> API Keys when supported.

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Explicit owner used by backend adapters when resolving Profile-vault credentials.
# This must exactly match the local UTT profile username; there is no any-user fallback.
UTT_VAULT_USERNAME=<your-ui-username>
UTT_AUTH_DISABLE=0
UTT_AUTH_DB=1

# Persistent auth-token signing secret. Use a unique high-entropy value stored
# outside the repository. If omitted, UTT uses a process-local secret and all
# login sessions become invalid whenever the backend restarts.
UTT_AUTH_SECRET=

# Stable master secret for encrypted local TOTP and Profile API-key-vault data.
# REQUIRED for vault save/read operations. Minimum 32 characters; 64+ random
# characters are recommended. There is no password, auth-secret, or public
# source-code fallback. Changing this makes existing ciphertext unreadable.
UTT_KMS_MASTER_KEY=
UTT_REALIZED_FIELDS_V1=1

# Keep the runtime database and backups outside the repository.
SQLITE_PATH=C:/path/to/utt-data/app.db
BACKUP_DIR=C:/path/to/utt-data/backups

# Global live-routing gates. Public example defaults remain fail-closed.
DRY_RUN=true
ARMED=false
LIVE_VENUES=

COINBASE_TOO_MANY_ERRORS_COOLDOWN_S=600
COINBASE_ALLOW_TRANSFER_MUTATIONS=0
COINBASE_TRANSFERS_FALLBACK_TO_TRADE_KEY=1
COINBASE_TRANSFERS_PREFER_V2=1
COINBASE_TRANSFERS_FORCE_V2=1
COINBASE_V2_TX_DEBUG=1
COINBASE_V2_KEEP_DEBUG=1
COINBASE_V2_TX_MAX_PAGES=0
COINBASE_V2_USE_KIND_ENDPOINTS=1
COINBASE_V2_RETRY_500=0
COINBASE_V2_RETRY_500_SLEEP=0
COINBASE_V2_KIND_MAX_PAGES=200
COINBASE_V2_KIND_PAGE_LIMIT=100
COINBASE_V2_INCLUDE_FIAT=0

ROBINHOOD_CRYPTO_BASE_URL=https://trading.robinhood.com
ROBINHOOD_ENABLED=true

DEX_TRADE_ENABLED=true
DEX_TRADE_BASE_URL=https://api.dex-trade.com
DEX_TRADE_SOCKET_BASE_URL=https://socket.dex-trade.com

CRYPTOCOM_EXCHANGE_BASE_URL=https://api.crypto.com/exchange/v1
CRYPTOCOM_INCLUDE_ORDER_HISTORY=1
CRYPTOCOM_DEBUG_ORDERS=1
CRYPTOCOM_ORDER_HISTORY_BYPASS_CACHE=1
CRYPTOCOM_OPEN_ORDERS_CACHE_TTL_S=0
CRYPTOCOM_ORDER_HISTORY_CACHE_TTL_S=0
CRYPTOCOM_ORDER_HISTORY_SCAN_ALL=1
CRYPTOCOM_ORDER_HISTORY_MIN_ROWS=20
CRYPTOCOM_ORDER_HISTORY_MAX_CALLS_PER_REFRESH=20
CRYPTOCOM_ORDER_HISTORY_MAX_INSTRUMENTS_PER_REFRESH=40
CRYPTOCOM_ORDER_HISTORY_LOOKBACK_MAX_MS=15552000000
CRYPTOCOM_ORDER_HISTORY_LOOKBACK_MS=7776000000
CRYPTOCOM_TRADES_LOOKBACK_MS=7776000000
CRYPTOCOM_TRY_ADV_HISTORY=0
CRYPTOCOM_USE_ADVANCED=0

UTT_JUP_SWAP_URL=https://api.jup.ag/swap/v1/swap
UTT_JUP_QUOTE_URL=https://api.jup.ag/swap/v1/quote
UTT_JUP_TIMEOUT_S=10

# Hydration public-safe routing and pricing defaults.
UTT_HYDRATION_RPC_PROVIDER=dwellir
UTT_HYDRATION_RPC_URL_TEMPLATE=https://api-hydration.n.dwellir.com/{api_key}
UTT_HYDRATION_WS_URL_TEMPLATE=wss://api-hydration.n.dwellir.com/{api_key}
UTT_HYDRATION_RPC_URL=

UTT_HYDRATION_ENABLE_ROUTER_QUOTES=0
UTT_HYDRATION_ENABLE_SWAP_TX=1
UTT_HYDRATION_ENABLE_EXACT_BUY=1
UTT_HYDRATION_ENABLE_MANUAL_POOL_FALLBACK=1
UTT_HYDRATION_MANUAL_POOL_LIVE_RESERVES=1
UTT_HYDRATION_ENABLE_MANUAL_ROUTER_FALLBACK=1
UTT_HYDRATION_ENABLE_ORDERBOOK_SYNTHETIC_FALLBACK=1

UTT_HYDRATION_ENABLE_EXTERNAL_USD_PRICES=1
UTT_HYDRATION_EXTERNAL_USD_PRICE_SOURCE=coingecko
UTT_HYDRATION_ENABLE_SDK_PRICE_CACHE=1
UTT_HYDRATION_PRICE_CACHE_USE_SIDECAR=0
UTT_HYDRATION_PRICE_CACHE_USE_SDK_FALLBACK=0
UTT_HYDRATION_PRICE_CACHE_TTL_S=300
UTT_HYDRATION_PRICE_CACHE_ERROR_BACKOFF_S=600
UTT_HYDRATION_EXTERNAL_USD_PRICE_TIMEOUT_S=5
UTT_HYDRATION_PRICE_CACHE_STRATEGY=spot_then_sell
UTT_HYDRATION_PRICE_CACHE_SPOT_IMPLEMENTATION=direct

UTT_HYDRATION_HELPER_STEP_TIMEOUT_S=30
UTT_HYDRATION_ORDERBOOK_STEP_TIMEOUT_S=25
UTT_HYDRATION_ORDERBOOK_MAX_CONSECUTIVE_ERRORS=1
UTT_HYDRATION_ORDERBOOK_FORCE_ISOLATED_HELPER=0

UTT_HYDRATION_ENABLE_SDK_ORDERBOOK_QUOTES=0
UTT_HYDRATION_ENABLE_SDK_ORDER_TICKET_QUOTES=0
UTT_HYDRATION_ENABLE_SDK_SWAP_TX=0
UTT_HYDRATION_ENABLE_BACKGROUND_SDK_PRICES=0
UTT_HYDRATION_ENABLE_STATE_CALL_QUOTES=0
UTT_HYDRATION_ENABLE_SDK_SPOT_ORDERBOOK=0
UTT_HYDRATION_SDK_SPOT_ORDERBOOK_IMPLEMENTATION=direct
UTT_HYDRATION_SDK_SPOT_ORDERBOOK_FORCE_ISOLATED_HELPER=1
UTT_HYDRATION_SDK_SPOT_ORDERBOOK_TRADABLE=0
UTT_HYDRATION_SDK_SPOT_ORDERBOOK_MIN_DAILY_VOLUME_USD=0
UTT_HYDRATION_SDK_SPOT_ORDERBOOK_POOL_TYPES=Omnipool,XYK,StableSwap

UTT_HYDRATION_USE_SIDECAR=0
UTT_HYDRATION_SIDECAR_URL=http://127.0.0.1:8787
UTT_HYDRATION_AUTOSTART_SIDECAR=0
UTT_HYDRATION_PRICE_CACHE_AUTOSTART_SIDECAR=0
UTT_HYDRATION_SIDECAR_QUOTE_CACHE=1
UTT_HYDRATION_SIDECAR_QUOTE_CACHE_TTL_MS=30000
UTT_HYDRATION_SIDECAR_QUOTE_CACHE_STALE_TTL_MS=300000
UTT_HYDRATION_SIDECAR_QUOTE_BACKOFF_MS=120000
UTT_HYDRATION_SIDECAR_QUOTE_CACHE_MAX_ENTRIES=100

# Robinhood Chain read-only defaults. Store provider API keys only through
# Profile -> API Keys under the appropriate provider venue.
ROBINHOOD_CHAIN_ENABLED=1
ROBINHOOD_CHAIN_RPC_HTTP=https://rpc.mainnet.chain.robinhood.com/
ROBINHOOD_CHAIN_RPC_WS=
ROBINHOOD_CHAIN_CHAIN_ID=4663
ROBINHOOD_CHAIN_TIMEOUT_S=15
ROBINHOOD_CHAIN_CACHE_TTL_S=30
ROBINHOOD_CHAIN_ERROR_BACKOFF_S=120
ROBINHOOD_CHAIN_MAX_CONCURRENT=1
ROBINHOOD_CHAIN_EXPLORER_API_BASE=https://robinhoodchain.blockscout.com/api/v2
ROBINHOOD_CHAIN_SWAP_PROVIDER=0x
ROBINHOOD_CHAIN_ZEROX_API_BASE=https://api.0x.org
ROBINHOOD_CHAIN_LIVE_EXECUTION_ENABLED=0

# Optional read-only Uniswap quote-provider settings. There is no environment
# API-key fallback; keep the key only in Profile -> API Keys as uniswap_api.
ROBINHOOD_CHAIN_UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1
ROBINHOOD_CHAIN_UNISWAP_QUOTE_TIMEOUT_S=15
ROBINHOOD_CHAIN_UNISWAP_QUOTE_MAX_CONCURRENT=1

# Counterparty broadcast and OKX live trading remain disabled in the public template.
COUNTERPARTY_LIVE_BROADCAST_ENABLED=0
OKX_ENABLE_TRADING=0

UTT_ORDERBOOK_TTL_SECONDS=2
UTT_ORDERBOOK_TIMEOUT_SECONDS=6
UTT_ORDERBOOK_GLOBAL_MAX_CONCURRENCY=8
UTT_ORDERBOOK_VENUE_MAX_CONCURRENCY=3
UTT_RATE_COOLDOWN_SECONDS=45
UTT_ORDERBOOK_NEG_PAIR_TTL_SECONDS=120
UTT_ORDERBOOK_NEG_RATE_TTL_SECONDS=60
BAL_MAX_PRICE_ASSETS=500
UTT_MAX_PRICE_ASSETS_PER_CALL=500
UTT_PRICING_FALLBACK_VENUES=coinbase,kraken,gemini
UTT_BALANCE_PRICING_VENUES=coinbase,kraken,gemini
